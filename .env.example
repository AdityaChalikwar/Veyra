# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Supabase → Project Settings → API Keys. The publishable key is safe in the
# browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where sign-in emails send people back to (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API key for AI analysis (Milestone 4). Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model runs the analysis (default claude-opus-5-5).
# ANALYSIS_MODEL=
